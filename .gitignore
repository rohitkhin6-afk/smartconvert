# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*

# Build and package artifacts
build/
dist/
*.egg-info/
*.egg

# Test, coverage, and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime-generated files
output/*
!output/.gitkeep
temp/*
!temp/.gitkeep
